# --- PRODUCTION DOMAIN & INFRA ---
DOMAIN_NAME=yourdomain.com
ENVIRONMENT=production
AUTH_ENABLED=true
TRUST_PROXY_HEADERS=false
KEYCLOAK_REALM=luminai
KEYCLOAK_ISSUER_URI=https://auth.yourdomain.com/realms/luminai

# --- DATABASE & INTER-SERVICE SECRETS (CHANGE IN PRODUCTION) ---
POSTGRES_DB=luminai
POSTGRES_USER=luminai_admin
POSTGRES_PASSWORD=change_me_strong_postgres_password
DATA_ENGINE_API_KEY=change_me_generate_strong_32_char_secret

# --- AMAZON S3 CONFIG (Replaces MinIO container) ---
MINIO_ENDPOINT=https://s3.eu-central-1.amazonaws.com
MINIO_ACCESS_KEY=your_aws_iam_access_key
MINIO_SECRET_KEY=your_aws_iam_secret_key
MINIO_SECURE=true