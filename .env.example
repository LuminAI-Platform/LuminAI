# --- PRODUCTION DOMAIN & INFRA ---
DOMAIN_NAME=yourdomain.com
ENVIRONMENT=production
AUTH_ENABLED=true
TRUST_PROXY_HEADERS=false
KEYCLOAK_REALM=luminai
KEYCLOAK_ISSUER_URI=https://auth.yourdomain.com/realms/luminai
CORS_ALLOWED_ORIGINS=https://luminai.yourdomain.com,https://app.yourdomain.com

# --- DATABASE, GRAPH & INTER-SERVICE SECRETS (REQUIRED IN PRODUCTION) ---
POSTGRES_DB=luminai
POSTGRES_USER=luminai_admin
POSTGRES_PASSWORD=change_me_strong_postgres_password
NEO4J_PASSWORD=change_me_strong_neo4j_password
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change_me_strong_keycloak_admin_password
KEYCLOAK_ADMIN_CLIENT_ID=luminai-admin-cli
KEYCLOAK_ADMIN_CLIENT_SECRET=change_me_keycloak_admin_client_secret
VAULT_ENCRYPTION_KEY=change_me_32_byte_aes_gcm_secret_key
DATA_ENGINE_API_KEY=change_me_generate_strong_32_char_secret

# --- OBJECT STORAGE (MINIO / AMAZON S3) ---
MINIO_ENDPOINT=https://s3.eu-central-1.amazonaws.com
MINIO_ACCESS_KEY=your_aws_iam_access_key
MINIO_SECRET_KEY=your_aws_iam_secret_key
MINIO_BUCKET_RAW=luminai-raw
MINIO_REGION=eu-central-1
MINIO_SECURE=true

# --- OPTIONAL AI INSIGHTS PROVIDERS ---
AI_INSIGHTS_PROVIDER=auto
GEMINI_API_KEY=
OPENAI_API_KEY=
