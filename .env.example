# ==============================================================================
# LUMINAI PLATFORM — ENVIRONMENT VARIABLE REGISTRY
# ==============================================================================
# Copy this file to .env and fill in the actual values.
# DO NOT commit .env to Git — only this .env.example file.
# Contact E5 (DevOps) for actual credential values.
# ==============================================================================

# --- POSTGRESQL (Local Dev) ---
POSTGRES_DB=luminai
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# --- POSTGRESQL (Cloud — Neon) ---
SPRING_FLYWAY_URL=jdbc:postgresql://<NEON_DIRECT_HOST>/luminai?sslmode=require&channel_binding=require
SPRING_FLYWAY_USER=neondb_owner
SPRING_FLYWAY_PASSWORD=<NEON_PASSWORD>
SPRING_DATASOURCE_URL=jdbc:postgresql://<NEON_POOLED_HOST>:6543/luminai?sslmode=require&channel_binding=require
SPRING_DATASOURCE_USERNAME=neondb_owner
SPRING_DATASOURCE_PASSWORD=<NEON_PASSWORD>
DATABASE_URL=postgresql://neondb_owner:<NEON_PASSWORD>@<NEON_POOLED_HOST>:6543/luminai?sslmode=require&channel_binding=require

# --- REDIS (Cloud — Upstash) ---
SPRING_DATA_REDIS_HOST=clean-bobcat-150871.upstash.io
SPRING_DATA_REDIS_PORT=6379
SPRING_DATA_REDIS_PASSWORD=<UPSTASH_REDIS_TOKEN>
SPRING_DATA_REDIS_SSL_ENABLED=true
REDIS_URL=rediss://default:<UPSTASH_REDIS_TOKEN>@clean-bobcat-150871.upstash.io:6379

# --- KAFKA (Cloud — Aiven) ---
KAFKA_BOOTSTRAP_SERVERS=<AIVEN_SERVICE_URI>
KAFKA_USERNAME=<AIVEN_KAFKA_USERNAME>
KAFKA_PASSWORD=<AIVEN_KAFKA_PASSWORD>
KAFKA_REPLICATION_FACTOR=1

# --- MINIO / OBJECT STORAGE (Local Dev) ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# --- OBJECT STORAGE (Cloud — Cloudflare R2) ---
MINIO_ENDPOINT=https://<CLOUDFLARE_ACCOUNT_ID>.r2.cloudflarestorage.com
MINIO_ACCESS_KEY=<R2_ACCESS_KEY_ID>
MINIO_SECRET_KEY=<R2_SECRET_ACCESS_KEY>
MINIO_SECURE=true

# --- NEO4J (Local Dev) ---
NEO4J_AUTH=neo4j/luminai_dev_password

# --- NEO4J (Cloud) ---
NEO4J_URI=<NEO4J_BOLT_URI>
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=<NEO4J_PASSWORD>

# --- KEYCLOAK (Local Dev) ---
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# --- KEYCLOAK (Cloud — cloud-iam.com) ---
KEYCLOAK_ISSUER_URI=https://lemur-3.cloud-iam.com/auth/realms/luminai-auth
KEYCLOAK_JWK_SET_URI=https://lemur-3.cloud-iam.com/auth/realms/luminai-auth/protocol/openid-connect/certs
KEYCLOAK_BASE_URL=https://lemur-3.cloud-iam.com/auth
KEYCLOAK_REALM=luminai-auth
KEYCLOAK_ADMIN_CLIENT_ID=luminai-backend
KEYCLOAK_ADMIN_CLIENT_SECRET=<KEYCLOAK_CLIENT_SECRET>

# --- SPRING BOOT ---
SPRING_PROFILES_ACTIVE=dev

# --- SECURITY ---
VAULT_ENCRYPTION_KEY=<RANDOM_32_CHARACTER_STRING>

# --- FRONTEND (Vercel) ---
VITE_API_URL=https://luminai-api.onrender.com
VITE_AUTH_URL=https://lemur-3.cloud-iam.com/auth/realms/luminai-auth
VITE_AUTH_CLIENT_ID=luminai-spa

# --- DAGSTER ---
DAGSTER_HOME=/tmp/dagster_home

# --- CORS ---
CORS_ALLOWED_ORIGINS=https://luminai-sand.vercel.app,http://localhost:5173